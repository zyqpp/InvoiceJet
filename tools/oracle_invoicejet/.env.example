# Runtime preset: rtx2060 or light.
ORACLE_MODEL_PRESET=rtx2060

# Repo and storage.
ORACLE_REPO_ROOT=../..
ORACLE_CHROMA_PATH=./chroma_data
ORACLE_MANIFEST_PATH=./index_manifest.json
ORACLE_COLLECTION_NAME=oracle_invoicejet_docs

# Ollama.
ORACLE_OLLAMA_BASE_URL=http://127.0.0.1:11434
ORACLE_LLM_MODEL=gemma3:4b
ORACLE_EMBEDDING_MODEL=bge-m3

# RAG parameters.
ORACLE_TOP_K=5
ORACLE_NUM_CTX=8192
ORACLE_TEMPERATURE=0.1
ORACLE_NUM_PREDICT=512
ORACLE_THINK=
ORACLE_STRIP_THINKING=true
ORACLE_CHUNK_SIZE=1800
ORACLE_CHUNK_OVERLAP=250
ORACLE_BATCH_SIZE=24
ORACLE_MIN_HITS=1

# Safety limits.
ORACLE_ALLOWED_MODELS=gemma3:12b,gemma3:4b,gemma3:1b,deepseek-r1:8b,qwen3:4b,qwen3-vl:4b,qwen3:1.7b,bge-m3,nomic-embed-text
ORACLE_EXCLUDE_DIRS=.git,node_modules,bin,obj,.venv,venv,chroma_data,.tmp,archiwum,docs,InvoiceJetAPI,InvoiceJetUI,wytyczne,_site,models,__pycache__

# Portale dokumentacji MkDocs.
ORACLE_DOCS_PORTAL_DOC_USER=http://127.0.0.1:8002
ORACLE_DOCS_PORTAL_DOC_AI=http://127.0.0.1:8001
