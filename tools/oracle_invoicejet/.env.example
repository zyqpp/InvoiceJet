# Runtime preset: rtx2060 or light.
ORACLE_MODEL_PRESET=rtx2060

# Repo and storage.
ORACLE_REPO_ROOT=../..
ORACLE_CHROMA_PATH=./chroma_data
ORACLE_MANIFEST_PATH=./index_manifest.json
ORACLE_COLLECTION_NAME=oracle_invoicejet_docs

# Ollama.
ORACLE_OLLAMA_BASE_URL=http://127.0.0.1:11434
ORACLE_LLM_MODEL=gemma3:4b
ORACLE_EMBEDDING_MODEL=bge-m3

# RAG parameters.
ORACLE_TOP_K=5
ORACLE_NUM_CTX=8192
ORACLE_TEMPERATURE=0.1
ORACLE_NUM_PREDICT=512
ORACLE_THINK=
ORACLE_STRIP_THINKING=true
ORACLE_CHUNK_SIZE=1800
ORACLE_CHUNK_OVERLAP=250
ORACLE_BATCH_SIZE=24
ORACLE_MIN_HITS=1

# Safety limits.
ORACLE_ALLOWED_MODELS=gemma3:12b,gemma3:4b,gemma3:1b,deepseek-r1:8b,qwen3:7b,qwen3:4b,qwen3-vl:4b,qwen3:1.7b,qwen2.5:1.5b,llama3.2:1b,SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M,SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0,SpeakLeash/bielik-1.5b-v3.0-instruct,bge-m3,qwen3-embedding:0.6b,nomic-embed-text
ORACLE_EXCLUDE_DIRS=.git,node_modules,bin,obj,.venv,venv,chroma_data,.tmp,archiwum,docs,InvoiceJetAPI,InvoiceJetUI,wytyczne,_site,models,__pycache__

# Portale dokumentacji MkDocs.
ORACLE_DOCS_PORTAL_DOC_USER=http://127.0.0.1:8002
ORACLE_DOCS_PORTAL_DOC_AI=http://127.0.0.1:8001

# Bielik — polskie modele LLM (SpeakLeash). Lepsze rozumienie polskiej terminologii.
# Aby przełączyć na Bielik: odkomentuj i zmień ORACLE_LLM_MODEL poniżej:
# ORACLE_LLM_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0   (~5.1GB VRAM)
# ORACLE_LLM_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M  (~6.7GB VRAM, 32k ctx)
# Aby użyć Bielik 1.5b jako light LLM (zamiast qwen2.5:1.5b):
# ORACLE_LIGHT_LLM_MODEL=SpeakLeash/bielik-1.5b-v3.0-instruct

# RAG v2.0 — Pipeline agentowy (multi-model routing).
# Light LLM do klasyfikacji, dekompozycji i fact-check (szybki, mały model ~1.5GB VRAM).
# Dostępne: qwen2.5:1.5b, llama3.2:1b, SpeakLeash/bielik-1.5b-v3.0-instruct
ORACLE_LIGHT_LLM_MODEL=qwen2.5:1.5b
# Agenty pipeline v2 (true/false):
# QueryClassifier — klasyfikuje intencję pytania, wymusza profil RAG
ORACLE_ENABLE_QUERY_CLASSIFIER=true
# QueryDecomposer — rozbija złożone pytania na pod-pytania (eksperymentalny)
ORACLE_ENABLE_QUERY_DECOMPOSER=false
# ContextHygiene — deduplikuje i filtruje chunki przed LLM
ORACLE_ENABLE_CONTEXT_HYGIENE=true
# MissingLink — wykrywa luki w wiedzy (brakujące typy dokumentów)
ORACLE_ENABLE_MISSING_LINK=true
# FactChecker — weryfikuje halucynacje po generacji (dodaje ~45s latencji)
ORACLE_ENABLE_FACT_CHECKER=false
