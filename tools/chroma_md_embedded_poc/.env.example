# Absolute or relative path to InvoiceJet repository root.
CHROMA_POC_PROJECT_ROOT=../../

# Directory where Chroma persistent data will be stored.
CHROMA_POC_CHROMA_PATH=./chroma_data

# Collection name in Chroma.
CHROMA_POC_COLLECTION_NAME=invoicejet_md_docs

# Comma-separated include patterns, evaluated recursively from project root.
CHROMA_POC_INCLUDE_GLOBS=*.md,*.MD

# Comma-separated directory names to exclude anywhere in the path.
CHROMA_POC_EXCLUDE_DIRS=.git,node_modules,bin,obj,.venv,venv,chroma_data,.tmp

# Chunking parameters in characters.
CHROMA_POC_CHUNK_SIZE=1800
CHROMA_POC_CHUNK_OVERLAP=250

# Default query result count.
CHROMA_POC_TOP_K=5

# Batch size for upsert operations.
CHROMA_POC_BATCH_SIZE=64
